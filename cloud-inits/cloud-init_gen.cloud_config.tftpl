#cloud-config

# Only the guest agent is installed by the packages module, so a failing
# extra package or a slow upgrade cannot block it.
package_update: true
package_upgrade: false

packages:
  - qemu-guest-agent

users:
- name: admin
  groups: sudo
  shell: /bin/bash
  sudo: ['ALL=(ALL) NOPASSWD:ALL']
  ssh_authorized_keys:
    - ${ssh_key}

preserve_hostname: false
manage_etc_hosts: true
fqdn: ${hostname}.${domain}
hostname: ${hostname}
prefer_fqdn_over_hostname: true
create_hostname_file: true

runcmd:
  - systemctl enable --now qemu-guest-agent
  - if command -v apt-get >/dev/null; then DEBIAN_FRONTEND=noninteractive apt-get install -y curl vim htop bash-completion; DEBIAN_FRONTEND=noninteractive apt-get upgrade -y; elif command -v dnf >/dev/null; then dnf install -y curl vim htop bash-completion; dnf upgrade -y; fi
